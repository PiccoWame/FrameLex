# Note: FrameLex requires each signed-in user to provide their own personal Gemini API key,
# bound exclusively to their authenticated account. No shared server GEMINI_API_KEY is used.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
